# Optional override for the Redrive-owned SQLite database.
# Defaults to .local/redrive.sqlite.
REDRIVE_DATABASE_PATH=.local/redrive.sqlite

# Explicit public base URL used for every GitHub App callback and URL.
# Use HTTPS except for localhost/127.0.0.1/::1 development.
REDRIVE_PUBLIC_URL=http://localhost:3000

# Filesystem location for Redrive-owned secrets. PEM files never enter SQLite.
# If unset, Redrive uses $HOME/.redrive/secrets outside the repository.
# REDRIVE_SECRET_DIR=/absolute/path/to/redrive-secrets

# Optional comma-separated hostname(s) for remote/Tailscale development.
# NEXT_ALLOWED_DEV_ORIGINS=your-machine.your-tailnet.ts.net

# Optional read-only GitHub MCP bridge configuration.
# REDRIVE_GITHUB_MCP_URL=https://your-mcp-bridge.example/mcp
# REDRIVE_GITHUB_MCP_TOKEN=
# Explicit hook mapping; never derive hook_id from repositoryId.
# REDRIVE_GITHUB_HOOK_IDS={"owner/receiver":"670245925"}
# For a single configured receiver, REDRIVE_GITHUB_HOOK_ID=670245925 may be used.

# TrueForge is the server-side owner of coordinator sessions.
# This must point at the TrueForge API (the local runtime default is port 8790).
REDRIVE_TRUEFORGE_URL=http://localhost:8790
# Required server-side TrueForge model/resource name. Redrive does not interpret
# this as a provider-specific model ID.
REDRIVE_TRUEFORGE_MODEL=
# Required name of the configured read-only GitHub MCP server in TrueForge.
# TrueForge Settings owns its URL and credentials.
REDRIVE_TRUEFORGE_GITHUB_MCP_NAME=
# Optional bearer token for a hosted TrueForge deployment.
# REDRIVE_TRUEFORGE_TOKEN=
